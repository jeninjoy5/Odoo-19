<?xml version="1.0" encoding="utf-8"?>

<odoo>

<!--VIEWS-->

    <record id="machine_tag_view_tree" model="ir.ui.view">
        <field name="name">machine.tag.list</field>
        <field name="model">machine.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="machine_tag_view_form" model="ir.ui.view">
        <field name="name">machine.tag.form</field>
        <field name="model">machine.tag</field>
        <field name="arch" type="xml">
            <form string="Machine Tag Details" class="machine_tag_details">
                <sheet>
                    <field name="name"/>
                </sheet>
            </form>
        </field>
    </record>

</odoo>

