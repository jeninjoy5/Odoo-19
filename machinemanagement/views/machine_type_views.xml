<?xml version="1.0" encoding="utf-8"?>

<odoo>

<!--VIEWS-->


    <record id="machine_type_view_tree" model="ir.ui.view">
        <field name="name">machine.type.list</field>
        <field name="model">machine.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="machine_ttpe_view_form" model="ir.ui.view">
        <field name="name">machine.type.form</field>
        <field name="model">machine.type</field>
        <field name="arch" type="xml">
            <form string="Machine Type Details" class="machine_type_details">
                <sheet>
                    <field name="name"/>
                </sheet>
            </form>
        </field>
    </record>

</odoo>

