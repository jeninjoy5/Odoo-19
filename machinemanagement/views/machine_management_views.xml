<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="action_machine" model="ir.actions.act_window">
        <field name="name">Machines</field>
        <field name="res_model">machine.management</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--VIEWS-->

    <record id="machine_management_view_tree" model="ir.ui.view">
        <field name="name">machine.management.list</field>
        <field name="model">machine.management</field>
        <field name="arch" type="xml">
            <list>
                <field name="machine_name"/>
                <field name="customer_id"/>
                <field name="purchase_value"/>
            </list>
        </field>
    </record>

    <record id="machine_management_view_form" model="ir.ui.view">
        <field name="name">machine.management.form</field>
        <field name="model">machine.management</field>
        <field name="arch" type="xml">
            <form string="Machine Details" class="machine_details">
                <header>
                    <button string="Ready to Transfer"
                            type="object"
                            class="oe_highlight"
                            name="action_machine_transfer_form_view"
                            invisible="state!='active'"/>
                    <button string="Start Service"
                            type="object"
                            name="action_service_form_view"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,in_service"/>
                </header>
                <sheet>
                    <div name="button_box">
                        <button class="oe_stat_button"
                                name="action_view_machine_transfer"
                                type="object"
                                icon="fa-signal">
                                    <field name="machine_transfer_count"
                                           widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button"
                                name="action_view_machine_service"
                                type="object"
                                icon="fa-wrench">
                                    <field name="machine_service_count"
                                           widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group name="machine_header">
                        <group name="details_of_machine">
                            <field name="machine_name"/>
                            <field name="serial_number"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="purchase_value" widget='monetary'/>
                            <field name="date_of_purchase"/>
                            <field name="machine_age"/>
                            <field name="machine_type_id"/>
                            <field name="company_id"/>
                            <field name="customer_id"
                                   widget="res_partner_many2one"
                                   readonly="state!='active'"
                                   context="{'res_partner_search_mode':
                                   'customer', 'show_address': 1,
                                   'show_vat': True}"/>
                            <field name="is_warranty"/>
                            <field name="machine_tag_ids"
                                   widget="many2many_tags"/>
                        </group>
                        <group name="upload_image">
                            <field name="image" widget="image" class="oe_avatar"
                                   options="{'preview_image': 'image_128'}"
                                   nolabel="1"/>
                        </group>
                        <notebook>
                            <page string="Order Lines" name="order_lines">
                                <field name="order_line_ids">
                                    <list string="Parts Order Lines"
                                          editable="bottom">
                                        <field name="parts_id"
                                               placeholder="Search a part"/>
                                        <field name="parts_qty"/>
                                        <field name="parts_uom_id"/>
                                        <control>
                                            <create name="add_product_control"
                                                    string="Add a part"/>
                                        </control>
                                    </list>
                                </field>
                            </page>
                            <page string="Description">
                                <field name="description"
                                       placeholder="Add a description..."/>
                            </page>
                            <page string="Instructions">
                                <field name="instructions"
                                       placeholder="Add instructions..."/>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_machine_filter" model="ir.ui.view">
        <field name="name">machine.select</field>
        <field name="model">machine.management</field>
        <field name="arch" type="xml">
            <search string="Search Machines">
                <filter string="Active"
                        name="active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="In Service"
                        name="in_service"
                        domain="[('state', '=', 'in_service')]"/>
                <filter string="Warranty"
                        name="warranty"
                        domain="[('is_warranty', '=', 'True')]"/>
                <group>
                    <filter string="Customer" name="customer"
                            context="{'group_by':'customer_id'}"/>
                    <filter string="Machine Type" name="machine_type"
                            context="{'group_by':'machine_type_id'}"/>
                    <filter string="Purchase Date" name="purchase_month"
                            context="{'group_by': 'date_of_purchase'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>